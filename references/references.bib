  title = {{Taming Throughput-Latency Tradeoff in LLM Inference with Sarathi-Serve}},
  booktitle = {18th USENIX Symposium on Operating Systems Design and Implementation (OSDI 2024)},
  year = {2024},
  url = {https://arxiv.org/abs/2403.02310},
  note = {Confirmed via the USENIX OSDI'24 proceedings (usenix.org/system/files/osdi24-agrawal.pdf): published at OSDI 2024, not MLSys 2024 (a related but distinct Agrawal et al. paper, 'Vidur: A Large-Scale Simulation Framework for LLM Inference', was the one accepted at MLSys 2024). Extends Sarathi's chunked-prefill with 'stall-free scheduling', admitting new requests into a running batch via prefill chunks without pausing ongoing decodes; reported gains (2.6x-5.6x serving capacity vs. vLLM) are model- and hardware-specific.}
}

