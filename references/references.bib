@inproceedings{dao-2022-flashattention,
  author = {Tri Dao and Daniel Y. Fu and Stefano Ermon and Atri Rudra and Christopher Ré},
  title = {{FlashAttention: Fast and Memory-Efficient Exact Attention with IO-Awareness}},
  booktitle = {Advances in Neural Information Processing Systems 35 (NeurIPS 2022)},
  year = {2022},
  url = {https://arxiv.org/abs/2205.14135},
  note = {IO-aware exact attention: reduces HBM accesses from Θ(Nd+N^2) to Θ(N^2 d^2 M^-1) and memory footprint from quadratic to linear in N. Theorem 1 gives the forward pass's FLOP count explicitly as O(N^2 d), the same asymptotic class as standard attention. Separately, the paper's own Figure 2 benchmark (forward+backward combined) reports FlashAttention's total FLOP count as slightly higher than standard attention's (66.6 vs. 75.2 GFLOPs in their GPT-2 test), explicitly attributed to recomputation in the backward pass — a training-specific effect, not applicable to the forward-pass-only prefill/decode path used at inference.}
}

