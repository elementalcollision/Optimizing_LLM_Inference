@misc{agrawal-2023-sarathi,
  author = {Amey Agrawal and Ashish Panwar and Jayashree Mohan and Nipun Kwatra and Bhargav S. Gulavani and Ramachandran Ramjee},
  title = {{Sarathi: Efficient LLM Inference by Piggybacking Decodes with Chunked Prefills}},
  howpublished = {arXiv:2308.16369},
  year = {2023},
  url = {https://arxiv.org/abs/2308.16369},
  note = {Introduces chunked-prefills (splitting a prefill request into equal-sized chunks) and decode-maximal batching ('piggybacking' decodes onto a prefill chunk). DistServe [@distserve] cites this paper (together with Sarathi-Serve) as the origin of 'chunked-prefill with piggyback'; reported gains (e.g. up to 10x decode throughput for LLaMA-13B on an A6000 GPU) are model- and hardware-specific.}
}

@inproceedings{agrawal-2024-sarathiserve,
